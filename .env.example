# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.
# Every value here has a working default in config.py; you only need to set what
# differs from that default (e.g. pointing at a teammate's laptop, or enabling AI).

# ---- Ditto connection ----
DITTO_URL=http://localhost:8080
DITTO_USER=ditto
DITTO_PASS=ditto
COMPOSE_PROJECT=docker

# ---- Simulated fleet / probing ----
NAMESPACE=org.hackathon
NUM_CARS=100
SEND_INTERVAL_S=2.0
PROBE_INTERVAL_S=2.0
REQUEST_TIMEOUT_S=5.0
SEARCH_DRIFT_TOLERANCE=2

# ---- File locations ----
STATE_DIR=state
METRICS_DIR=metrics
BASELINE_FILE=baseline.json
EXPERIMENTS_DIR=experiments
REPORTS_DIR=reports

# ---- probe.check_breach() thresholds (standalone health API; see probe.py) ----
MAX_ERROR_RATE=0.05
MAX_LATENCY_FACTOR=3.0
MIN_LATENCY_FLOOR_MS=200
MAX_STALE_S=15

# ---- guard.py's own kill-switch thresholds (separate from probe.py's, see README) ----
# BREACH_WINDOW=3
# MAX_ERROR_RATE_WINDOW=10
# RECOVERY_LATENCY_FACTOR=2.0
# RECOVERY_STALE_S=5.0
# MAX_BASELINE_AGE_S=3600
# LOCK_STALE_S=7200
# DOCKER_CMD_TIMEOUT_S=30

# ---- AI-assisted analysis (resilience_agent.py, planner_agent.py) -- entirely optional ----
# Leave AI_ENABLED=false (or GEMINI_API_KEY empty) to use the deterministic,
# rule-based fallback for both the planner and the analyst -- no key required,
# nothing ever calls out to Google.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_REQUEST_TIMEOUT_S=30

# ---- Dashboard backend API (api.py / `python main.py serve`) ----
# Binds to localhost only by default. Destructive endpoints (run/stop an experiment)
# have no authentication beyond "can reach this port" -- do NOT set API_HOST=0.0.0.0
# on a network you don't fully trust without adding real auth first.
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins the dashboard (frontend/, Vite dev server) may call the API from.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
